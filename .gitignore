# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large / generated artifacts (keep folder placeholders only)
data/*
!data/.gitkeep
models/*
!models/.gitkeep
!models/*.md
runs/*
!runs/.gitkeep
*.pt
*.onnx
*.engine

# Local config overrides and secrets (e.g. ROBOFLOW_API_KEY) — never commit
configs/local.yaml
configs/edge.local.yaml
configs/hub.local.yaml
.env
.env.*
!.env.example

# macOS / Xcode
.DS_Store
xcuserdata/
DerivedData/
*.xcuserstate

# iOS (XcodeGen: project.yml is the source of truth)
ios/*.xcodeproj/
ios/BOBCapture/Info.plist
ios/Signing.local.xcconfig
ios/build/
